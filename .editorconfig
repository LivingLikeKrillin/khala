root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4

[*.{ts,tsx,js,jsx,mjs,cjs,md,mdx,astro,json,yml,yaml}]
indent_size = 2

[*.{java,sql,toml}]
indent_size = 4

[*.{css,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
