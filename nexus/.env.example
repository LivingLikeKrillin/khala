# Nexus Environment Variables
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus
OLLAMA_URL=http://localhost:11434
ANTHROPIC_API_KEY=sk-ant-your-key-here
# LLM 답변 생성 모델 (선택). 미기재 시 코드 기본값(현행 Sonnet) 사용.
# 모델 EOL/교체 시 코드 수정 없이 이 한 줄만 바꾸면 된다. 예: claude-opus-4-8
NEXUS_LLM_MODEL=
# LLM 백엔드 (선택). 기본 anthropic(= ANTHROPIC_API_KEY 사용).
#   claude-code = dev 전용. 호스트에서 도는 Claude Code 를 브리지 경유로 써서 유료 키 없이 서술.
#   켜려면: (1) `task llm-bridge` 로 호스트 브리지 기동, (2) 아래 세 줄 설정.
# NEXUS_LLM_PROVIDER=claude-code
# NEXUS_LLM_BRIDGE_URL=http://host.docker.internal:8900
# NEXUS_LLM_BRIDGE_TOKEN=   # 임의 시크릿 — 브리지와 Nexus 가 같은 값을 써야 한다(무인증 방지)
# 브리지가 `claude` 한 번에 줄 시간(초). 미기재 시 120.
#   ⚠ 이 벽에 걸리면 504 이고, 응답 본문이 **몇 초에 걸렸는지**를 말한다.
#   실측 2026-09-19(이 배포): 검색 2.3초 · 합성 44.6초(답변 1,410자·근거 26). 그런데 설명 층이
#   질의에 정황을 싣자 100~119초가 됐고 120 초 벽에 **호출 셋 중 하나**가 걸렸다.
#   ⛔ 올리는 것이 유일한 처방이 아니다 — 합성이 그 시간을 쓰는 것 자체가 먼저 볼 값이다.
# NEXUS_LLM_BRIDGE_TIMEOUT=300
# 브리지가 동시에 띄우는 `claude` 프로세스 수. 미기재 시 1.
#   ⛔ 소켓은 스레드로 받지만 **생성은 이 수만큼만** 돈다. 스레드만 늘리면 호스트가 갈린다.
#   줄을 서다 못 들어간 요청은 503 이고, 본문이 **줄 선 것이지 느린 것이 아니라고** 말한다.
#   ⚠ 이 브리지는 설명 층만 쓰는 게 아니다 — 주기 재적재도 같은 문을 친다.
# NEXUS_LLM_BRIDGE_CONCURRENCY=1
# 문 앞에서 기다려 주는 시간(초). 미기재 시 5.
#   ⛔ **요청 예산을 줄 서는 데 다 쓰지 않는다.** 앞 건이 2분 걸릴 때 뒤 요청이 자기 시간을
#   전부 대기에 쓰면, 들어가도 남은 시간이 없거나 부르는 쪽이 자기 벽에서 먼저 죽는다
#   (2026-09-19 라이브에서 실제로 그랬다 — 503 을 볼 사람이 없었다).
#   짧게 기다리고 503 으로 돌려보낸다. 줄이 길다는 사실 자체가 정보다.
# NEXUS_LLM_BRIDGE_QUEUE_WAIT=5
TEMPO_URL=http://localhost:3200
OTEL_COLLECTOR_URL=http://localhost:4318
DEFAULT_TENANT=default

# ── 도메인 불변식·값 거버넌스(#17) 확장 ──
# Notion 적재용 토큰 (Notion → Settings → Integrations → internal integration)
NOTION_TOKEN=

# 대상 코드 checkout 경로 (코드 상수 해석용 — 컨테이너에 /code-src 로 마운트)
# 예: /abs/path/to/sample-app-checkout
CODE_SRC_PATH=

# 리포 밖 문서 코퍼스 경로 (적재용 — 컨테이너에 /ingest-src 로 읽기 전용 마운트)
# 예: /abs/path/to/another-repo/docs
# 적재는 컨테이너 안에서 돌린다 — 임베딩 세대가 env 로 오고 그 env 는 컨테이너에만 있다:
#   docker exec nexus-app python -m nexus.cli ingest /ingest-src --tenant <이름>
INGEST_SRC_PATH=

# ── 주기 재적재 (`docker compose --profile reingest up -d`) ──
# 위 경로를 주기적으로 다시 적재하는 잡. 켜려면 아래 **둘 다** 적어야 한다 — 하나라도 비면
# 잡이 시동을 거부한다. ⛔ 기본 테넌트를 주지 않는 이유: `INGEST_SRC_PATH` 가 비면 마운트가
# `./docs`(=khala 자기 문서)로 폴백하므로, 테넌트에 기본값이 있으면 이 잡은 **남의 코퍼스에
# 우리 문서를 주기적으로 밀어 넣는다.**
#
# ⚠ 이 잡은 `nexus-embed` 에 depends_on 을 걸지 않는다 — 사이드카가 프로파일 뒤에 있어서,
#   의존을 걸면 그 프로파일을 안 켠 배포가 아예 안 뜬다(앱 쪽에 같은 이유로 적혀 있다).
#   대신 회차마다 물어보고 못 닿으면 **그 회차를 건너뛴다**. 사이드카 없이 적재하면 조각이
#   전부 거부돼 코퍼스가 키워드로만 찾히는 상태로 남는다(2026-09-18 실측: 366/366 거부).
#   그래서 실제로 돌릴 때는 임베딩 프로파일도 같이 켠다:
#     docker compose --profile embed --profile reingest up -d
#
# 돌았는지는 `nexus persistence-health` 의 `ingest_runs` 줄에서 본다. **바뀐 게 없어도 행이
# 앉으므로**, 그 줄이 조용해지면 그것은 "코퍼스가 안 바뀌었다" 가 아니라 "잡이 죽었다" 다.
REINGEST_TENANT=
REINGEST_INTERVAL_SECONDS=3600

# 웹 온램프 토큰. 설정 시 앱이 INTERNAL local-dev principal 을 등록하고 웹이 /auth/dev-token 으로
# 받아 자동 Bearer 사용 → 검색 무마찰.
#   · 로컬 dev(docker-compose.override.yml): 미기재 시 약한 기본값 'nexus-local-dev'. localhost 전용이라 OK.
#   · 팀 배포(docker-compose.prod.yml): **필수 + 강값**. 미설정이면 compose 가, 약값이면 앱이 부트를 거부한다.
#     발급: python -m nexus.cli auth gen-token   (docs/TEAM_DOGFOOD_DEPLOY.md §1)
NEXUS_DEV_TOKEN=

# 이 두 신원이 **어느 코퍼스를 읽는가**. 비우면 각자 자기 테넌트 하나(=오늘)다.
#
# ⛔ 원소가 둘 이상이면 같은 이름의 `_CLEARANCE_VERIFIED` 가 있어야 앱이 뜬다. 그 한 줄은
#   *"두 테넌트의 등급 값 분포를 대 봤다"* 는 사람의 선언이고, 날짜를 적는다. 상한을 그냥
#   올리지 않은 이유가 이것이다 — 이번 쌍이 안전한 것은 **측정했기 때문**이지 일반 사실이 아니다
#   (SPEC-nexus-design-corpus-cutover §4.3).
#
# ⛔ 선언은 **principal 마다 따로**다. 한쪽 확인을 다른 쪽이 빌려 쓰면 그 선언이 무엇을 확인한
#   것인지 말할 수 없게 된다.
#
# ⚠ `local-dev` 는 `manage_documents` 를 갖고 `/auth/dev-token` 이 토큰을 도달한 누구에게나
#   내준다. 읽기 범위를 넓히는 것은 **그 문을 통과한 사람이 읽는 코퍼스**를 넓히는 일이다.
#
# 설계 문서를 웹·CLI 에서도 보이게 하려면 (실측 2026-09-03: 그전까지 근거로 온 적 0건):
#   NEXUS_DEV_READ_TENANTS=default,design_docs
#   NEXUS_DEV_CLEARANCE_VERIFIED=2026-08-31
NEXUS_DEV_READ_TENANTS=
NEXUS_DEV_CLEARANCE_VERIFIED=

# 슬랙 봇 신원의 같은 값 (이미 배포에 설정돼 있다).
NEXUS_SLACK_READ_TENANTS=
NEXUS_SLACK_CLEARANCE_VERIFIED=

# 통합 테스트용 — 주의: docker compose가 아니라 *호스트 셸*에 있어야 pytest가 실행.
#   PowerShell:  $env:NEXUS_TEST_DB_URL = "postgresql://nexus:nexus@localhost:5433/nexus_test"
# 없으면 @pytest.mark.integration 테스트는 자동 skip.
NEXUS_TEST_DB_URL=postgresql://nexus:nexus@localhost:5433/nexus_test

# ── 임베딩 세대 (SPEC-nexus-embedding-cutover-seam §4.2) ──
# 컷오버는 이 **셋을 함께** 움직이는 일이다. 하나만 움직이면 앱이 부팅을 거부하고 셋을 다 말해 준다.
# 미설정이면 compose 의 기본값(= 현행 세대)이 쓰이므로, 손대지 않은 배포는 아무것도 바뀌지 않는다.
#   현행:  nomic-embed-text · embedding      · ollama
#   전환:  KURE-v1          · embedding_1024 · sidecar   ← 재임베딩을 끝낸 뒤에만
# 롤백은 이 세 줄을 되돌리고 재기동하는 것이다(리포 파일은 건드리지 않는다).
NEXUS_EMBEDDING_MODEL=
NEXUS_EMBEDDING_COLUMN=
NEXUS_EMBEDDING_BACKEND=

# KURE 사이드카 체크포인트 핀. 비우면 compose 기본값(측정에 쓴 커밋)이 쓰인다.
# 리비전이 바뀌면 같은 차원의 **다른 벡터**가 조용히 섞인다 — 그래서 이름이 아니라 커밋이다.
EMBED_REVISION=
