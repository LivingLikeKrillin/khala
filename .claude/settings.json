{
  "permissions": {
    "allow": [
      "Bash(docker exec nexus-app python -m nexus.cli query *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep|Glob|Read",
        "hooks": [
          {
            "type": "command",
            "command": "python -S -E \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/knowledge_access.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
